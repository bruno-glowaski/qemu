#cloud-config
hostname: ubuntu-dev
manage_etc_hosts: true

users:
  - name: test
    gecos: Test Account
    groups: [adm, sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: password

chpasswd:
  expire: false

package_update: true
packages:
  - curl
  - git
  - vim
  - tmux
  - build-essential
  - linux-headers-generic
  - kmod
  - make
  - gcc
  - bc
  - flex
  - bison
  - libelf-dev
  - libssl-dev
  - dwarves

runcmd:
  - |
    if [ ! -d /home/test/qemu/.git ]; then
      git clone --branch hyperpipe --single-branch \
        https://github.com/bruno-glowaski/qemu.git /home/test/qemu
    fi
    chown -R test:test /home/test/test
